# Shared Frida config — copy once:
#   cp frida/config/env.example frida/config/frida.env
#
# Or run:  ~/dev/scripts/frida-setup.sh

export FRIDA_IPHONE_HOST=192.168.254.133
export FRIDA_IPHONE_USER=mobile
export FRIDA_SSH_PASS=mobile
export FRIDA_SSH_ROOT_PASS=alpine
export FRIDA_VENV=~/frida-env
export FRIDA_LOCAL_PORT=27042
